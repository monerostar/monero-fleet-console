# Copy to .env (gitignored) and fill in. Never commit real values.

# Required for Hive status
HIVEOS_API_TOKEN=
HIVEOS_FARM_ID=

# Optional Hive API base (default: https://api2.hiveos.farm/api/v2)
# HIVEOS_API_BASE=https://api2.hiveos.farm/api/v2

# Optional: path to a dotenv file (else project .env, then Hermes tech .env if present)
# HIVEOS_ENV_FILE=

# Optional: HashVault payout address for wallet/worker pool stats
HASHVAULT_WALLET=

# Optional: fleet role map JSON (default: ./fleet.local.json then fleet.example.json)
# FLEET_CONFIG=

# Optional monerod paths (Windows-oriented defaults; override for your layout)
# Default RPC is 127.0.0.1:18081 — on tech this is usually the 5800x SSH tunnel.
# MONEROD_RPC_URL=http://127.0.0.1:18081/json_rpc
# MONEROD_DATA_DIR=
# MONEROD_BINARY=
# Prefer tunnel ensure (main scripts); local monerod-start.py is manual backup only.
# MONEROD_START_SCRIPT=%LOCALAPPDATA%\hermes\profiles\main\scripts\monerod-ensure-rpc.py
# MONEROD_TUNNEL_SCRIPT=%LOCALAPPDATA%\hermes\profiles\main\scripts\tunnel-5800x-monerod.ps1

# Optional watchdog state path
# FLEET_WATCHDOG_STATE=
# FLEET_CONSOLE_ROOT=
